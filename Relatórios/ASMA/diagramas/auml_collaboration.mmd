%% ================================================================
%% Dance4Life — Diagrama de Colaboração AUML
%% Padrão  : AUML (Odell, Parunak & Bauer, 2001)
%% Protocolo : FIPA-Request (FIPA SC00026H)
%% Versão  : Mermaid flowchart
%%
%% Três protocolos representados como subgrafos independentes:
%%   ① sensor_activity
%%   ② movement_recommendation
%%   ③ matching
%%
%% Legenda de arestas:
%%   -->   Mensagem REQUEST  (canal ACL XMPP/SPADE)
%%   -.->  Mensagem INFORM   (confirmação / ack)
%%   ==>   Chamada HTTP externa (fora do canal ACL)
%% ================================================================

flowchart TD

  %% ── Estilos por papel de agente ──────────────────────────────
  classDef apiCls  fill:#1A5276,stroke:#0E2F51,color:#fff,font-weight:bold
  classDef saCls   fill:#1E8449,stroke:#145A32,color:#fff,font-weight:bold
  classDef caCls   fill:#B9770E,stroke:#7D6608,color:#fff,font-weight:bold
  classDef haCls   fill:#7D3C98,stroke:#512E5F,color:#fff,font-weight:bold
  classDef eaCls   fill:#0E6655,stroke:#0B5345,color:#fff,font-weight:bold
  classDef cluCls  fill:#943126,stroke:#641E16,color:#fff,font-weight:bold
  classDef dbCls   fill:#922B21,stroke:#641E16,color:#fff,font-weight:bold

  %% ════════════════════════════════════════════════════════════
  %% ① Protocolo FIPA-Request — ontologia: sensor_activity
  %%
  %% Participantes (instâncias AUML):
  %%   api_agent@localhost      : BaseSenderAgent
  %%   sensor_agent@localhost   : SensorAgent      [Reativo]
  %%   coordinator_agent@...    : CoordinatorAgent  [Híbrido]
  %%   har_agent@localhost      : HarAgent          [Reativo]
  %%   environment_agent@...    : EnvironmentAgent  [Híbrido]
  %%   database_agent@localhost : DatabaseAgent     [Reativo]
  %%
  %% Mensagens REQUEST (→):  1 → 2 → 3 → 4 → 5
  %% Mensagens INFORM  (-.): 3.1, 4.1, 5.1, 6
  %% ════════════════════════════════════════════════════════════
  subgraph F1["① FIPA-Request :: sensor_activity"]
    direction LR

    F1_API["api_agent@localhost\n:BaseSenderAgent"]:::apiCls
    F1_SA["sensor_agent@localhost\n:SensorAgent\n[Reativo]"]:::saCls
    F1_CA["coordinator_agent@localhost\n:CoordinatorAgent\n[Híbrido]"]:::caCls
    F1_HA["har_agent@localhost\n:HarAgent\n[Reativo · placeholder HAR]"]:::haCls
    F1_EA["environment_agent@localhost\n:EnvironmentAgent\n[Híbrido]"]:::eaCls
    F1_DB["database_agent@localhost\n:DatabaseAgent\n[Reativo de Serviço]"]:::dbCls

    %% REQUEST — pipeline principal (esquerda → direita)
    F1_API -->|"1: REQUEST / sensor_activity\nconv-id: conv-{jid}-guid-{uuid}"| F1_SA
    F1_SA  -->|"2: REQUEST / sensor_activity"| F1_CA
    F1_CA  -->|"3: REQUEST / sensor_activity"| F1_HA
    F1_HA  -->|"4: REQUEST / sensor_activity"| F1_EA
    F1_EA  -->|"5: REQUEST / sensor_activity\n[+weather_temperature]"| F1_DB

    %% INFORM — acks imediatos (direita → esquerda, tracejado)
    F1_CA  -.->|"3.1: INFORM / sensor_activity [ack]"| F1_SA
    F1_HA  -.->|"4.1: INFORM / sensor_activity [ack]"| F1_CA
    F1_EA  -.->|"5.1: INFORM / sensor_activity [ack]"| F1_HA
    F1_DB  -.->|"6: INFORM / sensor_activity\n[save_activity ok]"| F1_EA
  end

  %% ════════════════════════════════════════════════════════════
  %% ② Protocolo FIPA-Request — ontologia: movement_recommendation
  %%
  %% Participantes:
  %%   api_agent@localhost      : BaseSenderAgent
  %%   sensor_agent@localhost   : SensorAgent      [Reativo]
  %%   coordinator_agent@...    : CoordinatorAgent  [Híbrido]
  %%   database_agent@localhost : DatabaseAgent     [Reativo]
  %%
  %% Fluxo simplificado: sem passagem por HarAgent / EnvironmentAgent
  %% Mensagens REQUEST (→):  1 → 2 → 3
  %% Mensagens INFORM  (-.): 4
  %% ════════════════════════════════════════════════════════════
  subgraph F2["② FIPA-Request :: movement_recommendation"]
    direction LR

    F2_API["api_agent@localhost\n:BaseSenderAgent"]:::apiCls
    F2_SA["sensor_agent@localhost\n:SensorAgent\n[Reativo]"]:::saCls
    F2_CA["coordinator_agent@localhost\n:CoordinatorAgent\n[Híbrido]"]:::caCls
    F2_DB["database_agent@localhost\n:DatabaseAgent\n[Reativo de Serviço]"]:::dbCls

    %% REQUEST — pipeline principal
    F2_API -->|"1: REQUEST / movement_recommendation\nconv-id: conv-{jid}-guid-{uuid}"| F2_SA
    F2_SA  -->|"2: REQUEST / movement_recommendation"| F2_CA
    F2_CA  -->|"3: REQUEST / movement_recommendation\n[+recommendation=True]"| F2_DB

    %% INFORM — confirmação de persistência
    F2_DB  -.->|"4: INFORM / movement_recommendation\n[save_movement_recommendation ok]"| F2_CA
  end

  %% ════════════════════════════════════════════════════════════
  %% ③ Protocolo FIPA-Request — ontologia: matching
  %%
  %% Participantes:
  %%   api_agent@localhost      : BaseSenderAgent / Flask API
  %%   matching_agent@localhost : ClusteringAgent  [Deliberativo]
  %%   coordinator_agent@...    : CoordinatorAgent  [Híbrido]
  %%   database_agent@localhost : DatabaseAgent     [Reativo]
  %%
  %% Mensagem 2 é um efeito lateral HTTP (fora do canal ACL).
  %% O ClusteringAgent chama POST /set_user_match/{id} via requests.post()
  %% antes de encaminhar o resultado pelo canal ACL para CoordinatorAgent.
  %%
  %% Mensagens REQUEST (→):  1 → 3 → 4
  %% HTTP lateral   (==>):  2 (ClusteringAgent → Flask API)
  %% Mensagens INFORM  (-.): 5
  %% ════════════════════════════════════════════════════════════
  subgraph F3["③ FIPA-Request :: matching"]
    direction TB

    F3_API["api_agent@localhost\n:BaseSenderAgent / Flask API"]:::apiCls
    F3_CLU["matching_agent@localhost\n:ClusteringAgent\n[Deliberativo]"]:::cluCls
    F3_CA["coordinator_agent@localhost\n:CoordinatorAgent\n[Híbrido]"]:::caCls
    F3_DB["database_agent@localhost\n:DatabaseAgent\n[Reativo de Serviço]"]:::dbCls

    %% REQUEST ACL — pipeline principal
    F3_API -->|"1: REQUEST / matching\npayload: {new_data, users}\nconv-id: conv-{jid}-guid-{uuid}"| F3_CLU

    %% Efeito lateral HTTP (fora do canal ACL)
    F3_CLU ==>|"2: HTTP POST /set_user_match/{user_id}\n[notificação de convite — fora do canal ACL\nUserMatchingClusterModel.process_matching_request()]"| F3_API

    %% Retoma no canal ACL
    F3_CLU -->|"3: REQUEST / matching\n[base={invite_payload}]"| F3_CA
    F3_CA  -->|"4: REQUEST / matching\n[+recommendation=True]"| F3_DB

    %% INFORM — confirmação de persistência
    F3_DB  -.->|"5: INFORM / matching\n[save_matching ok]"| F3_CA
  end
