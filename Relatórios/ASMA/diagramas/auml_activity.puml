@startuml Dance4Life_M
' ================================================================
' Dance4Life -- Diagrama de Atividades AUML
' Protocolo : FIPA-Request (FIPA SC00026H)
' Ontologia : matching
' Fluxo     : API -> CluA -> CA -> DB
' Efeito lateral: CluA -> POST /set_user_match/{id} (HTTP)
' INFORM    : DB -> CA
' ================================================================
!theme plain
skinparam defaultTextAlignment center
skinparam activityBorderColor      #34495E
skinparam activityBackgroundColor  #FDFEFE
skinparam activityFontSize         10
skinparam activityFontName         Arial
skinparam swimlaneBorderColor      #5D6D7E
skinparam swimlaneBorderThickness  2
skinparam swimlaneTitleFontStyle   bold
skinparam swimlaneTitleFontSize    11
skinparam arrowColor               #2C3E50
skinparam arrowFontSize            9
skinparam NoteBackgroundColor      #FEF9E7
skinparam NoteBorderColor          #D4AC0D

title <b>Dance4Life -- Diagrama de Atividades AUML</b>\nProtocolo FIPA-Request :: matching

|API Flask|
start
note right
  <b>Iniciador:</b> BaseSenderAgent
  <b>Entrada:</b> POST /collect_data_activities
  Despacho paralelo apos asyncio.sleep
  Payload: {new_data, users}
end note
:Receber POST /collect_data_activities
[despacho paralelo -- fluxo matching];
:Criar mensagem ACL
performative: REQUEST
ontology: matching
conversation-id: conv-{jid}-guid-{uuid};

|ClusteringAgent|
note right
  <b>Agente Deliberativo</b>
  ReceiveClusteringDataBehaviour
  Guard: [performative == REQUEST]
end note
:Receber MSG ACL
REQUEST / matching;
if (performative == REQUEST?) then (sim)
else (nao)
  :Ignorar mensagem;
  stop
endif
:cluster_model.process_matching_request(payload)
UserActivityClusterModel
[raciocinio sobre perfis de utilizadores];
note right
  <b>Arquitetura Deliberativa</b>
  Inferencia de emparelhamento social
  com base em atividade e localizacao
end note
:_notify_cluster_invite(payload);

|API Flask|
note right
  <b>Efeito Lateral Externo</b>
  Chamada HTTP sincrona fora do canal ACL
end note
:Receber POST /set_user_match/{user_id}
[Notificacao de Convite de Emparelhamento];

|ClusteringAgent|
:forward_message()
-> CoordinatorAgent
REQUEST / matching;

|CoordinatorAgent|
note right
  <b>Agente Hibrido</b>
  Guard: [ontology == matching]
  Fluxo direto para DatabaseAgent
end note
:Receber MSG ACL
REQUEST / matching;
if (ontology == matching?) then (sim)
else (nao)
  stop
endif
:payload["recommendation"] = True;
:forward_message()
-> DatabaseAgent
REQUEST / matching;

|DatabaseAgent|
note right
  <b>Agente Reativo de Servico</b>
  ReceiveDatabaseDataBehaviour
end note
:Receber MSG ACL
REQUEST / matching;
:payload.pop("visited_agents");
:save_matching(payload)
-> Firestore: dance4life_matching;
:forward_message()
-> CoordinatorAgent
INFORM / matching;

|CoordinatorAgent|
:Receber INFORM
[ack de DatabaseAgent];

|API Flask|
:Retornar HTTP 200 OK
{"status": "ok"};
stop

@enduml
