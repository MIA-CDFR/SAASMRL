\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Diagrama de actividades AUML — Protocolo FIPA-Request, ontologia \texttt  {movement\_recommendation}. Fluxo simplificado: API $\rightarrow $ SensorAgent $\rightarrow $ CoordinatorAgent $\rightarrow $ DatabaseAgent. Retorno INFORM de DatabaseAgent para CoordinatorAgent.}}{11}{}\protected@file@percent }
\newlabel{fig:auml_mr}{{3}{11}{}{figure.3}{}}
