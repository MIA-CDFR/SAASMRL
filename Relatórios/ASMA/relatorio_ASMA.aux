\@writefile{toc}{\contentsline {subsection}{\numberline {2.7}Statecharts: Ciclo de Vida e Pipeline de Mensagens}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Diagrama de actividades AUML — Protocolo FIPA-Request, ontologia \texttt  {matching}. Fluxo: API $\rightarrow $ ClusteringAgent (inferência deliberativa) $\rightarrow $ notificação HTTP lateral (\texttt  {/set\_user\_match}) $\rightarrow $ CoordinatorAgent $\rightarrow $ DatabaseAgent. Retorno INFORM de DatabaseAgent para CoordinatorAgent.}}{12}{}\protected@file@percent }
\newlabel{fig:auml_m}{{4}{12}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Diagrama de colaboração AUML — Protocolo FIPA-Request, ontologia \texttt  {sensor\_activity}. Mensagens REQUEST numeradas 1--5 (setas sólidas, esquerda para a direita); mensagens INFORM 3.1, 4.1, 5.1 e 6 (setas tracejadas, direita para a esquerda). O \texttt  {conv-id} é propagado em todas as mensagens da conversação.}}{13}{}\protected@file@percent }
\newlabel{fig:collab_sa}{{5}{13}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Diagrama de colaboração AUML — Protocolo FIPA-Request, ontologia \texttt  {movement\_recommendation}. Fluxo simplificado de quatro mensagens: REQUEST 1--3 (API $\rightarrow $ SensorAgent $\rightarrow $ CoordinatorAgent $\rightarrow $ DatabaseAgent) e INFORM 4 de confirmação de persistência.}}{14}{}\protected@file@percent }
\newlabel{fig:collab_mr}{{6}{14}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Diagrama de colaboração AUML — Protocolo FIPA-Request, ontologia \texttt  {matching}. A mensagem 2 representa o efeito lateral HTTP (\texttt  {POST /set\_user\_match/\{id\}}) que o ClusteringAgent efectua directamente sobre a Flask API \textbf  {fora do canal ACL}, antes de encaminhar o resultado via XMPP para o CoordinatorAgent (mensagem 3).}}{15}{}\protected@file@percent }
\newlabel{fig:collab_m}{{7}{15}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Diagrama de sequência AUML — Protocolo FIPA-Request, ontologia \texttt  {sensor\_activity}. 11 mensagens numeradas: REQUEST 1--3, 5, 9 (setas sólidas); INFORM 4, 6, 8, 11 (setas tracejadas); auto-mensagens 7 (\texttt  {get\_weather\_temperature}) e 10 (\texttt  {save\_activity}). Os blocos de activação mostram o período em que cada agente aguarda resposta do downstream.}}{16}{}\protected@file@percent }
\newlabel{fig:seq_sa}{{8}{16}{}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Diagrama de sequência AUML — Protocolo FIPA-Request, ontologia \texttt  {movement\_recommendation}. Fluxo de 6 mensagens: REQUEST 1--2 (API$\rightarrow $SensorAgent$\rightarrow $CoordinatorAgent), auto-mensagem 3 (\texttt  {payload["recommendation"]=True}), REQUEST 4 ($\rightarrow $DatabaseAgent), auto-mensagem 5 (\texttt  {save\_movement\_recommendation}) e INFORM 6 de confirmação.}}{17}{}\protected@file@percent }
\newlabel{fig:seq_mr}{{9}{17}{}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Diagrama de sequência AUML — Protocolo FIPA-Request, ontologia \texttt  {matching}. A mensagem 3 (\texttt  {HTTP POST /set\_user\_match/\{id\}}) é um efeito lateral síncrono executado pelo ClusteringAgent \textbf  {fora do canal ACL} antes de retomar o protocolo FIPA-Request na mensagem 4. O processamento deliberativo do \texttt  {UserMatchingClusterModel} é representado como auto-mensagem 2.}}{18}{}\protected@file@percent }
\newlabel{fig:seq_m}{{10}{18}{}{figure.10}{}}
