\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Diagrama de actividades AUML — Protocolo FIPA-Request, ontologia \texttt  {sensor\_activity}. Fluxo: API $\rightarrow $ SensorAgent $\rightarrow $ CoordinatorAgent $\rightarrow $ HarAgent $\rightarrow $ EnvironmentAgent $\rightarrow $ DatabaseAgent. Retorno INFORM na direcção inversa após cada operação.}}{10}{}\protected@file@percent }
